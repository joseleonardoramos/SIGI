# Plantilla: la imagen de nginx reemplaza ${SIGI_*} al arrancar y la deja en /etc/nginx/conf.d/default.conf.
# Las variables propias de nginx ($host, $remote_addr…) no se tocan porque no son variables de entorno.

map $http_upgrade $sigi_connection {
  default upgrade;
  ''      close;
}

# HTTP: todo a HTTPS
server {
  listen 80 default_server;
  server_name _;
  return 301 https://${SIGI_DOMINIO}$request_uri;
}

server {
  listen 443 ssl default_server;
  http2 on;
  server_name ${SIGI_DOMINIO};
  server_tokens off;

  ssl_certificate     /etc/nginx/ssl/sigi.crt;
  ssl_certificate_key /etc/nginx/ssl/sigi.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;

  # DNS interno de Docker: los servicios se resuelven al usarse, así nginx arranca aunque falte alguno.
  resolver 127.0.0.11 valid=10s ipv6=off;

  client_max_body_size 12m;   # evidencias de hasta 10 MB + margen

  # API de Supabase
  location ~ ^/(auth|rest|storage|functions|realtime)/v1/ {
    set $sigi_api ${SIGI_API_UPSTREAM};
    proxy_pass http://$sigi_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header Upgrade $http_upgrade;       # Realtime (websocket)
    proxy_set_header Connection $sigi_connection;
    proxy_read_timeout 300s;                      # importaciones CSV grandes
    proxy_send_timeout 300s;
  }

  # Aplicación
  location / {
    set $sigi_web ${SIGI_WEB_UPSTREAM};
    proxy_pass http://$sigi_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }
}
