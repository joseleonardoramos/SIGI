# Copie a .env (no va al repositorio) y complete con los valores de: npx supabase status
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Usuarios de prueba locales para npm test (prueba de la función usuarios).
# Créelos con npm run admin:crear (Administrador) y desde Usuarios y roles (el de Captura).
# Solo para desarrollo: no use cuentas reales.
SIGI_PRUEBA_ADMIN_EMAIL=
SIGI_PRUEBA_ADMIN_PASSWORD=
SIGI_PRUEBA_CAPTURA_EMAIL=
SIGI_PRUEBA_CAPTURA_PASSWORD=
